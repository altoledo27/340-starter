<h1><%= title %></h1>
<%- messages() %>
<div class="add-form-container">
    <form action = "/inv/add-classification" method="post">
        <span>FIELD IS REQUIRED</span>
        <fieldset>
            <legend>Classification Name</legend>
            <span>NAME MUST BE ALPHABETIC CHARACTERS ONLY</span>
            <input type="text" id="classification-name" name="classification_name" required pattern ="^[a-zA-Z]+$" title="Name must be alphabetic characters only">
            <button type="submit" class="btn">Add Classification</button>
        </fieldset>
    </form>
</div>